{
  "name": "chhaap",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "npm run build -w @chhaap/functions && run-p dev:web dev:functions dev:emulators",
    "dev:web": "npm run dev -w @chhaap/web",
    "dev:functions": "npm run build:watch -w @chhaap/functions",
    "dev:emulators": "firebase emulators:start --project demo-chhaap",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint . --fix && eslint . --fix",
    "test": "npm run test:unit && npm run test:rules && npm run test:e2e",
    "test:unit": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-chhaap \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "npm run test:e2e -w @chhaap/web"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=24.12"
  }
}
