{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["./**/*"],
  "compilerOptions": {
    "types": ["node"],

    // Type-check only, as part of `vue-tsc --build` from ../tsconfig.json.
    "noEmit": true,
    // Playwright loads the e2e helpers from their `.ts` sources.
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
