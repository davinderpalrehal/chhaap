rules_version = '2';

// Story 1.1: deny everything. Story 1.2 adds the allowlist reads (AD-8).
// Client writes stay denied forever: every write goes through a command (AD-1).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
