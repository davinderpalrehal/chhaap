rules_version = '2';

// AD-8: reads need a team member (a verified email whose lowercased
// allowlist/{email} doc exists). Client writes stay denied forever: every write
// goes through a command (AD-1).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function selfKey() {
      return request.auth.token.email.lower();
    }

    function allowlistPath(email) {
      return /databases/$(database)/documents/allowlist/$(email);
    }

    function isTeam() {
      return isSignedInVerified() && exists(allowlistPath(selfKey()));
    }

    function isOwner() {
      return isTeam() && get(allowlistPath(selfKey())).data.role == 'owner';
    }

    // Rules OR every matching `allow`, so reads are granted per collection: a
    // catch-all read would expose other people's allowlist docs.
    match /allowlist/{email} {
      allow read: if isSignedInVerified() && (email == selfKey() || isOwner());
    }

    match /{coll}/{rest=**} {
      allow read: if coll != 'allowlist' && isTeam();
    }

    match /{path=**} {
      allow write: if false;
    }
  }
}
